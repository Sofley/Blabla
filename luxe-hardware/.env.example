# Скопируйте в .env и заполните.
PORT=3000

# Панель статистики /admin (логин и пароль). Без пароля панель выключена.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Telegram-бот: создайте у @BotFather, токен вставьте сюда.
TELEGRAM_BOT_TOKEN=
# Куда приходят заявки: ваш личный chat_id или id группы менеджеров (начинается с -100).
TELEGRAM_CHAT_ID=
# Любая длинная случайная строка — путь и секрет webhook для команд /stats и /leads.
TELEGRAM_WEBHOOK_SECRET=

# Случайная строка для хэширования IP (не меняйте после запуска, иначе «уникальные» посчитаются заново).
IP_SALT=

# 1 — если сайт стоит за Nginx/Caddy/Cloudflare (чтобы брать реальный IP из X-Forwarded-For).
TRUST_PROXY=0
